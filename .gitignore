# ความลับ — jira-tracker เก็บ API token ไว้ในนี้
.jira/config.local.json

# ของชั่วคราว
*.log
.DS_Store
Thumbs.db

# ฟีด GTFS ไม่ commit (41.8 MB ต่อเวอร์ชัน โหลดใหม่ได้จาก namtang-api.otp.go.th)
*.zip
gtfs/

# Secrets and environment
# .env.* covers .env.local, .env.production and friends. The example file is the
# contract for what keys exist, so it must stay tracked — add a matching negation for
# any other template file the project adopts (.env.sample, appsettings.example.json).
.env
.env.*
!.env.example

# Local-only overrides, any stack, any extension:
# appsettings.local.json, vite.config.local.ts, docker-compose.local.yml
*.local.*
*.local

# Editor and OS
# .vscode holds this repo's shared formatting settings and is committed on purpose —
# ignore the folder's personal contents, keep the two files the team relies on.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
desktop.ini
*.swp
*~

# Dependencies — the lock file is committed on purpose
node_modules/
.pnpm-store/

# Build output
dist/
tmp/
out-tsc/
bazel-out/

# Angular CLI cache
.angular/

# Test and coverage
coverage/

# TypeScript incremental build info
*.tsbuildinfo

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# .NET Core build output
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
x64/
x86/
artifacts/

# Visual Studio / Rider
.vs/
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# .NET test and coverage
[Tt]est[Rr]esult*/
*.coverage
*.coverolay
coverage*.json
coverage*.xml

# .NET publish
publish/
*.publishsettings
PublishProfiles/*.pubxml.user

# NuGet — the lock file is committed on purpose; it is what makes restores reproducible
*.nupkg
*.snupkg
packages/
!packages.lock.json

# Certificates with private keys. .gitattributes marks these binary so a deliberate,
# force-added one is never mangled — but none should be committed by accident.
*.pfx
*.p12
